{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aether-drop",
  "version": "0.1.0",
  "identifier": "com.alvwaretechnology.aether-drop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AetherDrop",
        "width": 1060,
        "height": 900,
        "minWidth": 720,
        "minHeight": 680,
        "resizable": true,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
